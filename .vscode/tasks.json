{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "C/C++: g++.exe build project",
            "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-g",
                "-std=c++17",
                "BlindRule.cpp",
                "GameManager.cpp",
                "HandGenerator.cpp",
                "HandPlayer.cpp",
                "PokerHandChecker.cpp",
                "RewardRule.cpp",
                "ScoringRule.cpp",
                "main.cpp",
                "Hands/FiveOfAKindChecker.cpp",
                "Hands/FlushChecker.cpp",
                "Hands/FlushFiveChecker.cpp",
                "Hands/FlushHouseChecker.cpp",
                "Hands/FourOfAKindChecker.cpp",
                "Hands/FullHouseChecker.cpp",
                "Hands/HighCardChecker.cpp",
                "Hands/PairChecker.cpp",
                "Hands/RoyalFlushChecker.cpp",
                "Hands/StraightChecker.cpp",
                "Hands/StraightFlushChecker.cpp",
                "Hands/ThreeOfAKind.cpp",
                "Hands/TwoPairChecker.cpp",
                "-I${workspaceFolder}",
                "-I${workspaceFolder}/Hands",
                "-o",
                "main.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Builds all project .cpp files (excludes SkipBlind)"
        }
    ]
}